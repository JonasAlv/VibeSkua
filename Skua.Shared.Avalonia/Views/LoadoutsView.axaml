<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vms="clr-namespace:Skua.Shared.Avalonia.ViewModels;assembly=Skua.Shared.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.Shared.Avalonia.Views.LoadoutsView"
             x:DataType="vms:LoadoutsViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
    <!-- Header Status Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="EQUIPMENT &amp; ENHANCEMENTS"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     Text="Loadouts Manager" />
        </StackPanel>

        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}"
                  PlaceholderText="Not Logged In"
                  MinWidth="160"
                  Height="26"
                  FontSize="12"
                  FontWeight="Bold"
                  VerticalAlignment="Center"
                  DropDownOpened="ProfileComboBox_DropDownOpened"
                  ToolTip.Tip="Edit the loadouts of an account logged in on any open tab" />

        <Border Grid.Column="2"
                Background="{DynamicResource SkuaSurfaceAltBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="10,4"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Loadouts.Count, StringFormat='Saved: {0}'}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}" />
        </Border>
      </Grid>
    </Border>

    <!-- Top Action Card -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
        <Button Grid.Column="0"
                Classes="skua-button"
                Content="Save"
                Command="{Binding SaveCurrentCommand}"
                IsEnabled="{Binding IsOwnProfile}" />
        <Button Grid.Column="1"
                Classes="skua-button"
                Content="Show Current"
                Command="{Binding ShowCurrentCommand}"
                IsEnabled="{Binding IsOwnProfile}" />
        <Button Grid.Column="2"
                Classes="skua-button"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh Loadouts"
                Width="32" Height="32"
                Padding="0">
          <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
        </Button>
        <ComboBox Grid.Column="3"
                  ItemsSource="{Binding Loadouts}"
                  SelectedItem="{Binding SelectedLoadout, Mode=TwoWay}"
                  PlaceholderText="Select Loadout..."
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="4"
                Classes="skua-button skua-primary"
                Content="Equip"
                Command="{Binding EquipLoadoutCommand}"
                IsEnabled="{Binding IsOwnProfile}" />
        <Button Grid.Column="5"
                Classes="skua-button outline"
                Content="Delete"
                Command="{Binding DeleteLoadoutCommand}"
                Foreground="#EF4444" />
      </Grid>
    </Border>

    <!-- Details Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
          <!-- Name -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedLoadoutName, Mode=TwoWay}" VerticalAlignment="Center" />

          <!-- Class -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Class" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedLoadout.Class}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" />
            <TextBlock Text=" [" Opacity="0.5" Margin="4,0,0,0" />
            <TextBlock Text="{Binding SelectedLoadout.ClassEnhancement}" Opacity="0.8" />
            <TextBlock Text="]" Opacity="0.5" />
          </StackPanel>

          <!-- Class enhance profile (CoreBots Options) -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Enhance" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding SelectedLoadout.Class, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <CheckBox Grid.Column="0"
                      Content="Use class profile"
                      IsChecked="{Binding UseClassEnhanceProfile}"
                      ToolTip.Tip="On Equip, enhance with this class's CoreBots Options profile instead of the enhancements saved with the loadout" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ClassEnhanceProfile}"                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Classes="skua-button"
                    Command="{Binding EditClassEnhanceProfileCommand}"
                    ToolTip.Tip="Edit this class's profile in CoreBots Options"
                    Width="28" Height="28"
                    Padding="0">
              <materialIcons:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
            </Button>
          </Grid>

          <!-- Armor -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Armor" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedLoadout.Armor}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />

          <!-- Weapon -->
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Weapon" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedLoadout.Weapon}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" />
            <TextBlock Text=" [" Opacity="0.5" Margin="4,0,0,0" />
            <TextBlock Text="{Binding SelectedLoadout.WeaponEnhancement}" Opacity="0.8" />
            <TextBlock Text="]" Opacity="0.5" />
          </StackPanel>

          <!-- Helm -->
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Helm" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedLoadout.Helm}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" />
            <TextBlock Text=" [" Opacity="0.5" Margin="4,0,0,0" />
            <TextBlock Text="{Binding SelectedLoadout.HelmEnhancement}" Opacity="0.8" />
            <TextBlock Text="]" Opacity="0.5" />
          </StackPanel>

          <!-- Cape -->
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Cape" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedLoadout.Cape}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" />
            <TextBlock Text=" [" Opacity="0.5" Margin="4,0,0,0" />
            <TextBlock Text="{Binding SelectedLoadout.CapeEnhancement}" Opacity="0.8" />
            <TextBlock Text="]" Opacity="0.5" />
          </StackPanel>

          <!-- Pet -->
          <TextBlock Grid.Row="7" Grid.Column="0" Text="Pet" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedLoadout.Pet}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />

          <!-- Amulet -->
          <TextBlock Grid.Row="8" Grid.Column="0" Text="Amulet" Foreground="{DynamicResource SkuaMutedTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedLoadout.Amulet}" FontWeight="SemiBold" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
