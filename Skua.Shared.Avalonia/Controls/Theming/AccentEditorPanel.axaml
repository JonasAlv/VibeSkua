<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             xmlns:sharedSettings="clr-namespace:Skua.Shared.Avalonia.Controls.Settings"
             x:Class="Skua.Shared.Avalonia.Controls.Theming.AccentEditorPanel"
             x:Name="Root">
  <StackPanel Spacing="10">
    
    <!-- Mode & Custom Color Bar -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <sharedSettings:LabeledToggleRow Label="Dark Mode"
                                         IsChecked="{Binding ThemeService.IsDarkTheme, Mode=TwoWay}" />
        <sharedSettings:LabeledToggleRow x:Name="ColorAdjustmentToggle"
                                         Label="Auto Color Contrast"
                                         IsChecked="{Binding ThemeService.IsColorAdjusted, Mode=TwoWay}" />
      </StackPanel>

      <!-- Compact ColorPicker (Popup flyout only when clicked) -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Custom Accent:"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                   VerticalAlignment="Center" />
        <cp:ColorPicker Color="{Binding ThemeService.SelectedColor, Mode=TwoWay}"
                        Height="34"
                        Width="64"
                        IsAlphaVisible="False"
                        VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Advanced Color Calibration Expander (Collapsed by default) -->
    <Expander Header="Advanced Color Calibration"
              IsExpanded="False"
              IsVisible="{Binding IsChecked, ElementName=ColorAdjustmentToggle}">
      <StackPanel Spacing="8" Margin="4">
        <TextBlock Text="Desired Contrast Ratio" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
        <sharedSettings:SliderValueRow Minimum="1"
                                       Maximum="21"
                                       TickFrequency="0.1"
                                       IsSnapToTickEnabled="True"
                                       Value="{Binding ThemeService.DesiredContrastRatio}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Contrast Method" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ThemeService.ContrastValues}"
                      SelectedItem="{Binding ThemeService.ContrastValue}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Color Selection Scope" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ThemeService.ColorSelectionValues}"
                      SelectedItem="{Binding ThemeService.ColorSelectionValue}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Expander>

  </StackPanel>
</UserControl>
