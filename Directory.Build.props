<?xml version="1.0" encoding="utf-8"?>
<Project>
    <!-- 1. Project, Compiler & External Runtime Versions -->
    <PropertyGroup>
        <Version Condition="'$(Version)' == ''">2.1.2</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>

        <!-- Skua-Mugetsu & WatchDog Versions -->
        <SkuaPlayerVersion Condition="'$(SkuaPlayerVersion)' == ''">1.6.0-skua.4</SkuaPlayerVersion>
        <SkuaPlayerOs Condition="'$(SkuaPlayerOs)' == ''">linux</SkuaPlayerOs>
        <WatchDogVersion Condition="'$(WatchDogVersion)' == ''">1.0.2</WatchDogVersion>

        <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;IL2026;IL2075;IL3000;WFO0003;CS4014;CS0618;CS0169;CS0414;CS0108;MVVMTK0034;CS8619;CS8620;CS8765;CS0114;CS8609;CS8610;CS0105;FodyPackageReference;CS1591;IL2091;IL2046;IL2072;IL2070;CS8669;CS0168;CS0162;CS1573;CS1723;CS1734;CS1572;CS0109;RS2000;RS1041;RS1036;CS1570;CS0436;RS1031;RS1032;SYSLIB0014;CS8714;MSB3277</NoWarn>
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
        <DisableFody>false</DisableFody>
    </PropertyGroup>

    <Target Name="SetLinuxSupportedOSPlatform" BeforeTargets="GetAssemblyAttributes" Condition="'$(TargetFramework)' == 'net10.0'">
        <ItemGroup>
            <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
                <_Parameter1>linux</_Parameter1>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!-- 2. Architecture Validation Targets (merged from Directory.Build.targets) -->
    <Target Name="AvaloniaStats" />

    <Target Name="ValidateAvaloniaArchitecture" BeforeTargets="ResolveReferences">
        <ItemGroup Condition="'$(MSBuildProjectName)' == 'Skua.Manager.Avalonia'">
            <_ForbiddenManagerRefs
                Include="@(ProjectReference)"
                Condition="'%(ProjectReference.Filename)' == 'Skua.App.Avalonia'" />
        </ItemGroup>

        <Error
            Condition="'$(MSBuildProjectName)' == 'Skua.Manager.Avalonia' and '@(_ForbiddenManagerRefs)' != ''"
            Text="Architecture violation: Skua.Manager.Avalonia must not reference Skua.App.Avalonia." />

        <ItemGroup Condition="'$(MSBuildProjectName)' == 'Skua.App.Avalonia'">
            <_ForbiddenAppRefs
                Include="@(ProjectReference)"
                Condition="'%(ProjectReference.Filename)' == 'Skua.Manager.Avalonia'" />
        </ItemGroup>

        <Error
            Condition="'$(MSBuildProjectName)' == 'Skua.App.Avalonia' and '@(_ForbiddenAppRefs)' != ''"
            Text="Architecture violation: Skua.App.Avalonia must not reference Skua.Manager.Avalonia." />

        <ItemGroup Condition="'$(MSBuildProjectName)' == 'Skua.Shared.Avalonia'">
            <_ForbiddenSharedRefs
                Include="@(ProjectReference)"
                Condition="$([System.String]::Copy('%(ProjectReference.Filename)').Contains('.App.')) Or $([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('Skua.Manager'))" />
        </ItemGroup>

        <Error
            Condition="'$(MSBuildProjectName)' == 'Skua.Shared.Avalonia' and '@(_ForbiddenSharedRefs)' != ''"
            Text="Architecture violation: Skua.Shared.Avalonia must not reference app/manager projects. Found: @(_ForbiddenSharedRefs->'%(Filename)', ', ')." />
    </Target>
</Project>