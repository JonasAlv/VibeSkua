<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CBOClassSelectViewModel"
             x:Class="Skua.App.Avalonia.Views.CBOClassSelectView">
  <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0">
    
    <!-- Top Action Bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="AccountStarOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Combat Class &amp; Skill Configurations"
                     FontWeight="Bold"
                     FontSize="12"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Column="1"
                Classes="skua-button"
                Height="28"
                Padding="10,0"
                Command="{Binding ReloadClassesCommand}"
                ToolTip.Tip="Refresh player classes from current inventory">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" />
            <TextBlock Text="Reload Classes" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- 2x2 Class Cards Grid -->
    <Grid Grid.Row="1"
          RowDefinitions="*,*"
          ColumnDefinitions="*,*"
          RowSpacing="10"
          ColumnSpacing="10">
      
      <!-- 1. Solo Class Card -->
      <Border Grid.Row="0"
              Grid.Column="0"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,12">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="SwordCross" Width="16" Height="16" Foreground="{DynamicResource SkuaSuccessBrush}" />
              <TextBlock Text="Solo Class" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="10" Padding="6,2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1">
              <TextBlock Text="SINGLE TARGET" FontSize="9" FontWeight="Bold" Foreground="#34D399" />
            </Border>
          </Grid>

          <StackPanel Spacing="3">
            <TextBlock Text="Selected Class" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding PlayerClasses}"
                      SelectedItem="{Binding SelectedSoloClass}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Text="Skill Rule / Preset" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding SoloModeStrings}"
                      SelectedItem="{Binding SelectedSoloModeString}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <CheckBox Content="Use Dedicated Equipment Loadout"
                    IsChecked="{Binding UseSoloEquipment}"
                    FontSize="11"
                    Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- 2. Farm Class Card -->
      <Border Grid.Row="0"
              Grid.Column="1"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,12">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="SproutOutline" Width="16" Height="16" Foreground="{DynamicResource SkuaWarningBrush}" />
              <TextBlock Text="Farm Class" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="10" Padding="6,2" Background="#451A03" BorderBrush="#D97706" BorderThickness="1">
              <TextBlock Text="AOE FARMING" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" />
            </Border>
          </Grid>

          <StackPanel Spacing="3">
            <TextBlock Text="Selected Class" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding PlayerClasses}"
                      SelectedItem="{Binding SelectedFarmClass}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Text="Skill Rule / Preset" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding FarmModeStrings}"
                      SelectedItem="{Binding SelectedFarmModeString}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <CheckBox Content="Use Dedicated Equipment Loadout"
                    IsChecked="{Binding UseFarmEquipment}"
                    FontSize="11"
                    Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- 3. Dodge Class Card -->
      <Border Grid.Row="1"
              Grid.Column="0"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,12">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="ShieldAccountOutline" Width="16" Height="16" Foreground="#60A5FA" />
              <TextBlock Text="Dodge Class" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="10" Padding="6,2" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1">
              <TextBlock Text="SURVIVABILITY" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
            </Border>
          </Grid>

          <StackPanel Spacing="3">
            <TextBlock Text="Selected Class" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding PlayerClasses}"
                      SelectedItem="{Binding SelectedDodgeClass}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Text="Skill Rule / Preset" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding DodgeModeStrings}"
                      SelectedItem="{Binding SelectedDodgeModeString}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <CheckBox Content="Use Dedicated Equipment Loadout"
                    IsChecked="{Binding UseDodgeEquipment}"
                    FontSize="11"
                    Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- 4. Boss Class Card -->
      <Border Grid.Row="1"
              Grid.Column="1"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,12">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="CrownOutline" Width="16" Height="16" Foreground="#A78BFA" />
              <TextBlock Text="Boss Class" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="10" Padding="6,2" Background="#2E1065" BorderBrush="#8B5CF6" BorderThickness="1">
              <TextBlock Text="HEAVY BOSS" FontSize="9" FontWeight="Bold" Foreground="#C4B5FD" />
            </Border>
          </Grid>

          <StackPanel Spacing="3">
            <TextBlock Text="Selected Class" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding PlayerClasses}"
                      SelectedItem="{Binding SelectedBossClass}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Text="Skill Rule / Preset" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding BossModeStrings}"
                      SelectedItem="{Binding SelectedBossModeString}"
                      HorizontalAlignment="Stretch"
                      Height="30" />
          </StackPanel>

          <CheckBox Content="Use Dedicated Equipment Loadout"
                    IsChecked="{Binding UseBossEquipment}"
                    FontSize="11"
                    Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
