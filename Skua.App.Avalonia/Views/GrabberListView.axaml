<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.Grabber"
             xmlns:controls="clr-namespace:Skua.Shared.Avalonia.Controls;assembly=Skua.Shared.Avalonia"
             xmlns:converters="clr-namespace:Skua.App.Avalonia.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.GrabberListView"
             x:DataType="vms:GrabberListViewModel"
             mc:Ignorable="d" d:DesignHeight="480" d:DesignWidth="750">

  <UserControl.Resources>
    <converters:GrabberItemDisplayConverter x:Key="GrabberItemDisplayConverter" />
    <converters:BooleanToSelectionModeConverter x:Key="BooleanToSelectionModeConverter" />
  </UserControl.Resources>

  <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
    
    <!-- Top Search & Option Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <TextBox Grid.Column="0"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Watermark="Search grabbed items..."
                 Text="{Binding SearchText, Mode=TwoWay}" />

        <CheckBox Grid.Column="1"
                  Content="Select Multiple"
                  VerticalAlignment="Center"
                  IsVisible="{Binding SelectMultiple}"
                  IsChecked="{Binding IsMultipleSelection, Mode=TwoWay}" />
      </Grid>
    </Border>

    <!-- Main List & Property Inspector Card -->
    <Grid Grid.Row="1" ColumnDefinitions="3*,8,2*" Margin="0">
      <!-- Left: Grabbed Items List Card -->
      <Border Grid.Column="0"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6">
        <ListBox Classes="card-list" x:Name="GrabbedItemsList"
                 ItemsSource="{Binding GrabbedItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 SelectionMode="{Binding IsMultipleSelection, Converter={StaticResource BooleanToSelectionModeConverter}}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="list-card alt"
                      BorderThickness="1"
                      CornerRadius="6"
                      Margin="0,0,0,4"
                      Padding="8,6">
                <TextBlock Text="{Binding Converter={StaticResource GrabberItemDisplayConverter}}"
                           FontFamily="JetBrains Mono,Consolas,Courier New,monospace"
                           FontSize="11"
                           Foreground="{DynamicResource SkuaTextBrush}" />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <!-- Right: Property Inspector Card -->
      <Border Grid.Column="2"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8">
        <controls:PropertyGridControl SelectedObject="{Binding SelectedItem}" />
      </Border>
    </Grid>

    <!-- Commands Toolbar Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Classes="skua-button outline"
                Content="Unselect All"
                Click="UnselectAll_Click"
                Margin="0,2,6,2"
                Height="32"
                Padding="12,0"
                IsEnabled="{Binding !IsBusy}" />

        <Button Classes="skua-button outline"
                Click="CopyButton_Click"
                Margin="0,2,6,2"
                Height="32"
                Padding="10,0"
                ToolTip.Tip="Copy grabbed items to clipboard"
                IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            <TextBlock Text="Copy" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="skua-button outline"
                Click="ExportButton_Click"
                Margin="0,2,6,2"
                Height="32"
                Padding="10,0"
                ToolTip.Tip="Export grabbed items to a .txt file"
                IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <materialIcons:MaterialIcon Kind="FileExportOutline" Width="14" Height="14" />
            <TextBlock Text="Export to TXT" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <ItemsControl ItemsSource="{Binding GrabberCommands}" IsEnabled="{Binding !IsBusy}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="skua-button"
                      Height="32"
                      Padding="12,0"
                      Margin="0,2,6,2"
                      Content="{Binding Content}"
                      Click="GrabberTaskButton_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </WrapPanel>
    </Border>

    <!-- Bottom Grab Action Card -->
    <Border Grid.Row="3"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <Button Grid.Column="0"
                Classes="skua-button skua-primary"
                Height="34"
                HorizontalAlignment="Stretch"
                Command="{Binding GrabCommand}"
                IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" />
            <TextBlock Text="Grab Data" VerticalAlignment="Center" FontWeight="Bold" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="12,0,0,0"
                    IsVisible="{Binding ShowMessage}"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding ProgressReportMessage}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <Button Classes="skua-button skua-danger"
                  Content="Cancel"
                  Command="{Binding CancelTaskCommand}"
                  Margin="8,0,0,0"
                  Height="30" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
