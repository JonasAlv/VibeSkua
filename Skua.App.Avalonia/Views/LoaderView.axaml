<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.LoaderView"
             x:DataType="vms:LoaderViewModel"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="750">

  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    
    <!-- Top Load & Search Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <StackPanel Spacing="10">
        <!-- Load by ID Bar -->
        <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Height="34"
                   VerticalContentAlignment="Center"
                   Watermark="Shop/Quest ID (e.g. 1234 or comma-separated: 101, 102)"
                   Text="{Binding InputIDs, Mode=TwoWay}" />

          <ComboBox Grid.Column="1"
                    Height="34"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <ComboBoxItem Content="Shop" />
            <ComboBoxItem Content="Quests" />
          </ComboBox>

          <Button Grid.Column="2"
                  Classes="skua-button skua-primary"
                  Height="34"
                  Command="{Binding LoadCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Download" Width="14" Height="14" />
              <TextBlock Text="Load" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Search & Progress Bar -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBox Grid.Column="0"
                   Height="32"
                   VerticalContentAlignment="Center"
                   Watermark="Search cached quests by name..."
                   Text="{Binding SearchText, Mode=TwoWay}" />

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding IsLoading}"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding ProgressReport}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SkuaMutedTextBrush}" />
            <Button Classes="skua-button skua-danger"
                    Content="Cancel"
                    Command="{Binding CancelQuestLoadCommand}"
                    Height="28"
                    Padding="8,2" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Quests List Card -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaPageBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
      <ListBox Classes="card-list" x:Name="QuestList"
               ItemsSource="{Binding FilteredQuestIDs}"
               SelectedItem="{Binding SelectedQuest, Mode=TwoWay}"
               SelectionMode="Multiple"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="list-card"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,4"
                    Padding="10,8">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2"
                        Margin="8,0,0,0">
                  <TextBlock Text="{Binding ID, StringFormat='ID: {0}'}"
                             FontFamily="JetBrains Mono,Consolas,Courier New,monospace"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Actions & Tools Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <StackPanel Spacing="10">
        <!-- Action Toolbar 1 -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="skua-button" Height="32" Padding="12,0" Content="Update" Click="UpdateMissing_Click" ToolTip.Tip="Preserves quests in QuestData.json and adds new ones." />
            <Button Classes="skua-button" Height="32" Padding="12,0" Content="All" Click="UpdateAll_Click" ToolTip.Tip="Overrides all quests in QuestData.json." />
            <Border Width="1" Height="20" Background="{DynamicResource SkuaBorderBrush}" Margin="2,0" VerticalAlignment="Center" />
            <Button Classes="skua-button" Height="32" Padding="12,0" Content="Copy IDs" Click="CopyIds_Click" ToolTip.Tip="Copy selected quest IDs separated by comma." />
            <Button Classes="skua-button" Height="32" Padding="12,0" Content="Copy Names" Click="CopyNames_Click" ToolTip.Tip="Copy selected quest names separated by comma." />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="skua-button" Height="32" Padding="12,0" Content="Fake Complete" Command="{Binding UpdateSelectedQuestCommand}" CommandParameter="{Binding SelectedQuest}" ToolTip.Tip="Sends quest complete packet to client." />
            <Button Classes="skua-button skua-primary" Height="32" Padding="14,0" Content="Load" Click="LoadSelected_Click" ToolTip.Tip="Load selected quests in game." FontWeight="SemiBold" />
          </StackPanel>
        </Grid>

        <!-- Action Toolbar 2 (Range & Copy Name+ID) -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
          <TextBox Grid.Column="0"
                   Height="32"
                   VerticalContentAlignment="Center"
                   Watermark="Quest range (e.g. 2566, 2599)"
                   Text="{Binding QuestRange, Mode=TwoWay}" />

          <Button Grid.Column="1"
                  Classes="skua-button"
                  Height="32"
                  Padding="12,0"
                  Content="Update Range"
                  Command="{Binding UpdateQuestsRangeCommand}" />

          <Button Grid.Column="2"
                  Classes="skua-button outline"
                  Height="32"
                  Padding="12,0"
                  Content="Copy Name+ID"
                  Click="CopyNamesAndIds_Click"
                  ToolTip.Tip="Copy selected quests in '// Name | ID' format." />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
