<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CurrentDropsView"
             x:DataType="vms:CurrentDropsViewModel"
             mc:Ignorable="d" d:DesignHeight="480" d:DesignWidth="560">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    
    <!-- Header Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="FLOOR ITEM MONITOR"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     Text="Current Drops" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="{DynamicResource SkuaSurfaceAltBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="10,4"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding FilteredCurrentDrops.Count, StringFormat='Available: {0}'}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}" />
        </Border>
      </Grid>
    </Border>

    <!-- Search Card -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <TextBox Height="34"
               VerticalContentAlignment="Center"
               Watermark="Search current drops..."
               Text="{Binding SearchText, Mode=TwoWay}" />
    </Border>

    <!-- Drops List Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource SkuaPageBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
      <ListBox Classes="card-list" x:Name="DropsList"
               ItemsSource="{Binding FilteredCurrentDrops}"
               SelectedItem="{Binding SelectedDrop, Mode=TwoWay}"
               SelectionMode="Multiple"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="list-card"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,4"
                    Padding="10,8">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Grid.Column="0"
                                            Kind="PackageVariantClosed"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource SkuaMutedTextBrush}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Border Background="#263A2A"
                          BorderBrush="#3E6B48"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="6,2"
                          IsVisible="{Binding Coins}">
                    <TextBlock Text="AC"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#FFD700" />
                  </Border>
                  <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                          BorderBrush="{DynamicResource SkuaBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="8,2">
                    <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Bottom Action Toolbar Card -->
    <Border Grid.Row="3"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="0"
                Classes="skua-button skua-primary"
                Height="34"
                Click="PickupSelected_Click">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="CursorDefaultClick" Width="14" Height="14" />
            <TextBlock Text="Pickup Selected" VerticalAlignment="Center" FontWeight="Bold" />
          </StackPanel>
        </Button>

        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="1"
                Classes="skua-button"
                Height="34"
                Command="{Binding PickupAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="SelectAll" Width="14" Height="14" />
            <TextBlock Text="Pickup All" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="2"
                Classes="skua-button"
                Height="34"
                Command="{Binding PickupACCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <materialIcons:MaterialIcon Kind="Star" Width="14" Height="14" Foreground="{DynamicResource SkuaGoldBrush}" />
            <TextBlock Text="Pickup AC Only" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
