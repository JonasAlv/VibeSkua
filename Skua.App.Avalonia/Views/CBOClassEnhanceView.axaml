<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CBOClassEnhanceViewModel"
             x:Class="Skua.App.Avalonia.Views.CBOClassEnhanceView">
  <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0">

    <!-- Top Action Bar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <materialIcons:MaterialIcon Kind="AutoFix" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Auto Enhance Profiles Per Class"
                     FontWeight="Bold"
                     FontSize="12"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="skua-button skua-primary" Height="28" Padding="10,0" Command="{Binding EnhanceCommand}" ToolTip.Tip="Enhance the equipped items using the profile of the current class">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" />
              <TextBlock Text="Enhance" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="skua-button" Height="28" Padding="10,0" Command="{Binding ImportCommand}" ToolTip.Tip="Import custom profiles from a JSON file">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="FileImportOutline" Width="13" Height="13" />
              <TextBlock Text="Import" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="skua-button" Height="28" Padding="10,0" Command="{Binding ExportCommand}" ToolTip.Tip="Export custom profiles to a JSON file">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="FileExportOutline" Width="13" Height="13" />
              <TextBlock Text="Export" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="skua-button" Height="28" Padding="10,0" Command="{Binding RefreshInventoryCommand}" ToolTip.Tip="Refresh owned classes from player inventory">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" />
              <TextBlock Text="Refresh Inventory" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="skua-button" Height="28" Padding="10,0" ToolTip.Tip="What each enhancement does">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <materialIcons:MaterialIcon Kind="BookOpenVariant" Width="13" Height="13" />
              <TextBlock Text="Wiki" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer Width="460" MaxHeight="480">
                  <StackPanel Spacing="6" Margin="4,4,12,4">
                    <StackPanel.Styles>
                      <Style Selector="TextBlock.wiki-h">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
                        <Setter Property="Margin" Value="0,8,0,0" />
                      </Style>
                      <Style Selector="TextBlock.wiki-d">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
                      </Style>
                      <Style Selector="TextBlock.wiki-d Run.n">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
                      </Style>
                    </StackPanel.Styles>

                    <TextBlock Classes="wiki-h" Margin="0" Text="Base (stats on every item)" />
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Lucky" /><Run Text=" — Mostly LUK plus a little of every stat. All-round choice used by most classes." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Fighter" /><Run Text=" — STR and END, some DEX. Physical damage with extra HP." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Thief" /><Run Text=" — DEX and STR, some END. Physical damage focused on DEX." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Hybrid" /><Run Text=" — STR and INT balanced, some DEX and END. For classes that deal physical and magic damage." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Wizard" /><Run Text=" — INT, with WIS and LUK. Magic damage." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Healer" /><Run Text=" — INT and END, some WIS. Magic healers and survivability." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="SpellBreaker" /><Run Text=" — INT and WIS, some END and LUK. Magic damage with more WIS." /></TextBlock>

                    <TextBlock Classes="wiki-h" Text="Weapon (Forge)" />
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Forge" /><Run Text=" — Forge stats, no special effect." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Lacerate" /><Run Text=" — 2nd skill (2s cooldown): 80% physical damage that always hits and crits, applies Laceration to the target for 15s." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Smite" /><Run Text=" — 5th skill (15s cooldown): 500% hybrid damage." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Valiance" /><Run Text=" — Auto attack (15s cooldown): Valiance buff on you for 20s, boosting all your stats." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Arcana's Concerto" /><Run Text=" — 50% on auto attack: 50% hybrid damage and an Arcana's Concerto stack on the target (up to 11, 22s)." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Acheron" /><Run Text=" — 3rd skill: 80% magic damage to up to 2 targets, always hits and crits, gives you a Stygian stack per target (up to 30, 6s)." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Elysium" /><Run Text=" — 3rd skill: 500–2250% magic damage to up to 2 targets, higher the lower your mana. Cannot crit." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Praxis" /><Run Text=" — 2nd skill (4s cooldown): 70% hybrid damage, +10% for each consecutive hit on the same target. The target's next hit deals 0." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Dauntless" /><Run Text=" — 2nd skill (3s cooldown): 190–570% physical damage, higher the lower your HP. Dauntless buff on you for 12s." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Ravenous" /><Run Text=" — 3rd skill: 75–338% hybrid damage, higher the lower the target's HP. Ravenous buff on you and Consumed stacks on the target." /></TextBlock>

                    <TextBlock Classes="wiki-h" Text="Weapon (Awe) — used when the Forge one is locked" />
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Spiral Carve" /><Run Text=" — 15% on auto attack: 200% hybrid damage and +25% crit chance for 10s." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Awe Blast" /><Run Text=" — 30% on auto attack: 100% hybrid damage, target gets -15% crit chance and -15% damage resistance for 10s." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Health Vamp" /><Run Text=" — 50% on auto attack: 80% true damage and heals you for 125% of it." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Mana Vamp" /><Run Text=" — 80% on auto attack: 50% true damage and recovers 10 mana." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Powerword Die" /><Run Text=" — 0.3% on auto attack: 999,999 true damage." /></TextBlock>

                    <TextBlock Classes="wiki-h" Text="Cape" />
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Forge" /><Run Text=" — Forge stats, no special effect." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Absolution" /><Run Text=" — +50% healing boost, -20% physical boost." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Avarice" /><Run Text=" — +10% haste, -35% damage resistance." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Vainglory" /><Run Text=" — +15% damage boost, -50% healing received." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Penitence" /><Run Text=" — +25% damage resistance, -25% damage over time boost." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Lament" /><Run Text=" — +20% crit chance, -5% haste." /></TextBlock>

                    <TextBlock Classes="wiki-h" Text="Helm" />
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Forge" /><Run Text=" — STR, INT and LUK, no special effect." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Vim" /><Run Text=" — DEX focused, some LUK, less END. -33% mana consumption." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Examen" /><Run Text=" — WIS focused, some LUK, less END. -33% mana consumption." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Anima" /><Run Text=" — STR focused, less END. +10% hit chance." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Pneuma" /><Run Text=" — INT focused, less END. +10% hit chance." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Hearty" /><Run Text=" — Large END (more HP), slightly lower other stats." /></TextBlock>

                    <TextBlock Classes="wiki-h" Text="Options" />
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="None" /><Run Text=" — Base enhancement only, no special." /></TextBlock>
                    <TextBlock Classes="wiki-d"><Run Classes="n" Text="Keep" /><Run Text=" — Leaves that item's enhancement as it is." /></TextBlock>

                    <TextBlock Classes="wiki-d" Margin="0,10,0,0" FontStyle="Italic" Text="Source: AQWorlds Wiki (aqwwiki.wikidot.com). Values can change with game updates." />
                  </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="10">

      <!-- Class List -->
      <Border Grid.Column="0"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="6">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
          <TextBox Grid.Row="0" Text="{Binding SearchText}" Watermark="Search class..." Height="28" />
          <CheckBox Grid.Row="1" Content="Only owned classes" IsChecked="{Binding OnlyOwned}" FontSize="11" />
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry}"
                   Classes="embedded">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vms:ClassEnhanceEntry">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="6,4">
                  <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <materialIcons:MaterialIcon Grid.Column="1" Kind="BagPersonal" Width="12" Height="12"
                                              Foreground="{DynamicResource SkuaMutedTextBrush}" IsVisible="{Binding Owned}"
                                              ToolTip.Tip="In your inventory" />
                  <materialIcons:MaterialIcon Grid.Column="2" Kind="CheckCircle" Width="13" Height="13"
                                              Foreground="#10B981" IsVisible="{Binding Enabled}"
                                              ToolTip.Tip="Custom profile" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Profile Editor -->
      <Border Grid.Column="1"
              Background="{DynamicResource SkuaSurfaceBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,12">
        <StackPanel Spacing="10" DataContext="{Binding SelectedEntry}" x:DataType="vms:ClassEnhanceEntry">
          <TextBlock Text="{Binding Display}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" />

          <CheckBox Content="Use custom profile" IsChecked="{Binding Enabled}"
                    ToolTip.Tip="Checked: only your selection is used. Unchecked: the recommended enhancements are used." />

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Base" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vms:CBOClassEnhanceViewModel.BaseEnhancements}" SelectedItem="{Binding Base}" Height="28" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Weapon (Forge)" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vms:CBOClassEnhanceViewModel.WeaponForgeSpecials}" SelectedItem="{Binding WeaponForge}" Height="28" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Weapon (Awe)" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vms:CBOClassEnhanceViewModel.WeaponAweSpecials}" SelectedItem="{Binding WeaponAwe}" Height="28" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cape" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vms:CBOClassEnhanceViewModel.CapeSpecials}" SelectedItem="{Binding Cape}" Height="28" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Helm" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vms:CBOClassEnhanceViewModel.HelmSpecials}" SelectedItem="{Binding Helm}" Height="28" HorizontalAlignment="Stretch" />
          </Grid>

          <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}"
                     Text="Values start as the recommended setup. Changing any slot makes it a custom profile, and then only your selection is used: the weapon takes the Forge special if unlocked, else the Awe one; any special you don't have unlocked becomes the base enhancement only. None removes the special (base only), Keep leaves that item as it is (Keep on Weapon (Forge) keeps the whole weapon). Uncheck to go back to the recommendation. The Default profile, when checked, applies to every class without a custom profile." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
