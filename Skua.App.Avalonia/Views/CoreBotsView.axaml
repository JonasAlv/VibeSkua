<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CoreBotsViewModel"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.CoreBotsView">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
    <!-- Profile and its actions -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
              Background="{DynamicResource SkuaSurfaceAltBrush}"
              BorderBrush="{DynamicResource SkuaBorderBrush}"
              BorderThickness="1">
        <materialIcons:MaterialIcon Kind="AccountCircleOutline" Width="18" Height="18"
                                    Foreground="{DynamicResource SkuaAccentBrush}" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
        <TextBlock Text="Account" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
        <ComboBox HorizontalAlignment="Stretch" MinWidth="180" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  ToolTip.Tip="Pick another open account: Load and Save use that account's CoreBots file. An account with no file yet starts from the values shown." />
      </StackPanel>
      <Button Grid.Column="2" Classes="skua-button w84" Command="{Binding LoadCommand}" ToolTip.Tip="Load saved CoreBots settings">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
          <TextBlock Text="Load" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="skua-button w140" Command="{Binding LoadCharacterCommand}"
              ToolTip.Tip="Load in-game character equipment and classes">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="AccountSyncOutline" Width="15" Height="15" />
          <TextBlock Text="Load character" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" Classes="skua-button skua-primary w84" Command="{Binding SaveCommand}" ToolTip.Tip="Save current CoreBots options">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" />
          <TextBlock Text="Save" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Tabs; the Options tab's search sits on the right -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ListBox Grid.Column="0"
               Classes="top-tabs-client"
               ItemsSource="{Binding CoreBotsTabs}"
               SelectedItem="{Binding SelectedTab}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Header}" Classes="top-tabs-label" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBox Grid.Column="1" Width="220" Watermark="Search options"
               IsVisible="{Binding IsOptionsTabSelected}"
               Text="{Binding OptionsTab.SearchText, Mode=TwoWay}">
        <TextBox.InnerLeftContent>
          <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Grid>

    <ContentControl Grid.Row="2" Content="{Binding SelectedTab.Content}" />
  </Grid>
</UserControl>
