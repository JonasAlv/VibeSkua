<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             x:DataType="vms:CoreBotsViewModel"
             Background="{DynamicResource SkuaPageBrush}"
             x:Class="Skua.App.Avalonia.Views.CoreBotsView">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="10">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
              Background="{DynamicResource SkuaSurfaceAltBrush}" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
        <materialIcons:MaterialIcon Kind="AccountCircleOutline" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Profile" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" PlaceholderText="Not Logged In"
                    MinWidth="150" Height="26" FontSize="12" FontWeight="Bold" DropDownOpened="ProfileComboBox_DropDownOpened"
                    ToolTip.Tip="Edit the CoreBots options of an account logged in on any open tab" />
        </StackPanel>
        <TextBlock Text="CoreBots automated routine preferences" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="skua-button" Height="30" Padding="10,0" Command="{Binding LoadCommand}" ToolTip.Tip="Load saved CoreBots settings">
          <StackPanel Orientation="Horizontal" Spacing="5"><materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" /><TextBlock Text="Load" FontSize="11" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="skua-button skua-primary" Height="30" Padding="12,0" Command="{Binding SaveCommand}" ToolTip.Tip="Save current CoreBots options">
          <StackPanel Orientation="Horizontal" Spacing="5"><materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14" /><TextBlock Text="Save" FontSize="11" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="skua-button" Height="30" Padding="10,0" Command="{Binding LoadCharacterCommand}" ToolTip.Tip="Load in-game character equipment and classes">
          <StackPanel Orientation="Horizontal" Spacing="5"><materialIcons:MaterialIcon Kind="AccountSyncOutline" Width="14" Height="14" /><TextBlock Text="Load character" FontSize="11" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ListBox Grid.Row="1" Classes="top-tabs-client" ItemsSource="{Binding CoreBotsTabs}" SelectedItem="{Binding SelectedTab}"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Header}" Classes="top-tabs-label" /></DataTemplate></ListBox.ItemTemplate>
    </ListBox>

    <ContentControl Grid.Row="2" Content="{Binding SelectedTab.Content}" />
  </Grid>
</UserControl>
