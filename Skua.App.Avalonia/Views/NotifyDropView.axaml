<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.NotifyDropView">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    
    <!-- Header Status Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="AUDIO &amp; POPUP ALERTS"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     Text="Drop Notifications" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="{DynamicResource SkuaSurfaceAltBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="10,4"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding NotifyDropList.Count, StringFormat='Active Alerts: {0}'}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}" />
        </Border>
      </Grid>
    </Border>

    <!-- Top Input & Sound Configuration Card -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <StackPanel Spacing="10">
        <!-- Add Drop Bar -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Height="34"
                   VerticalContentAlignment="Center"
                   Watermark="Enter item names separated by | (e.g. Legion Token | Dark Crystal Shard)"
                   Text="{Binding AddDropInput}" />
          <Button Grid.Column="1"
                  Classes="skua-button skua-primary"
                  Height="34"
                  Command="{Binding AddDropCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
              <TextBlock Text="Add" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Classes="skua-button outline"
                  Height="34"
                  Content="Remove Selected"
                  Click="RemoveSelected_Click" />
          <Button Grid.Column="3"
                  Classes="skua-button skua-danger"
                  Height="34"
                  Content="Clear All"
                  Command="{Binding RemoveAllDropsCommand}" />
        </Grid>

        <!-- Sound Settings Bar -->
        <Border Height="1" Background="{DynamicResource SkuaBorderBrush}" />

        <Grid ColumnDefinitions="Auto,90,Auto,110,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <TextBlock Grid.Column="0"
                     Text="Beep Count:"
                     FontWeight="SemiBold"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <NumericUpDown Grid.Column="1"
                         Height="32"
                         Minimum="1"
                         Maximum="25"
                         Value="{Binding SoundCount}" />

          <TextBlock Grid.Column="2"
                     Text="Delay (ms):"
                     FontWeight="SemiBold"
                     FontSize="12"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <NumericUpDown Grid.Column="3"
                         Height="32"
                         Minimum="10"
                         Maximum="2000"
                         Increment="10"
                         Value="{Binding SoundDelay}" />

          <Button Grid.Column="5"
                  Classes="skua-button"
                  Height="32"
                  Command="{Binding TestBeepCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" />
              <TextBlock Text="Test Alert" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Notification List Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource SkuaPageBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
      <ListBox Classes="card-list" x:Name="NotifyDropListBox"
               ItemsSource="{Binding NotifyDropList}"
               SelectionMode="Multiple"
               KeyDown="NotifyDropListBox_KeyDown"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="list-card"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,4"
                    Padding="10,8">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Grid.Column="0"
                                            Kind="BellOutline"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource SkuaMutedTextBrush}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2">
                  <TextBlock Text="Monitored"
                             FontSize="10"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Remove Selected" Click="RemoveSelected_Click" />
            <MenuItem Header="Clear All" Command="{Binding RemoveAllDropsCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
    </Border>

    <!-- Hint Footer -->
    <TextBlock Grid.Row="3"
               Text="💡 Use in-game exact item names. Press Delete to remove selected."
               FontSize="11"
               Foreground="{DynamicResource SkuaMutedTextBrush}" />
  </Grid>
</UserControl>
