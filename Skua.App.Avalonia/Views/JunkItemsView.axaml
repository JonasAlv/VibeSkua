<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.Runtime"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.JunkItemsView"
             x:DataType="vms:JunkItemsViewModel"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="600">

  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    
    <!-- Header Status Card -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="INVENTORY CLEANUP TOOL"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaMutedTextBrush}" />
          <TextBlock FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SkuaTextBrush}"
                     Text="Junk Items Manager" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
          <CheckBox Content="Skip sell warning"
                    IsChecked="{Binding SkipSellWarning, Mode=TwoWay}"
                    VerticalAlignment="Center" />
          <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                  BorderBrush="{DynamicResource SkuaBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="20"
                  Padding="10,4"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalJunk, StringFormat='Total Junk: {0}'}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SkuaTextBrush}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Search Card -->
    <Border Grid.Row="1"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <TextBox Height="34"
               VerticalContentAlignment="Center"
               Watermark="Search items by ID or name..."
               Text="{Binding SearchText, Mode=TwoWay}" />
    </Border>

    <!-- Items List Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource SkuaPageBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
      <ListBox Classes="card-list" ItemsSource="{Binding FilteredItems}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="list-card"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,4"
                    Padding="10,8">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <CheckBox Grid.Column="0"
                          Margin="0,0,10,0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Display}"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Background="#3B2323"
                        BorderBrush="#6E3333"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,2"
                        IsVisible="{Binding IsJunk}">
                  <TextBlock Text="JUNK"
                             FontSize="10"
                             FontWeight="Bold"
                             Foreground="#EF4444" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Bottom Action Toolbar Card -->
    <Border Grid.Row="3"
            Background="{DynamicResource SkuaSurfaceBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="0"
                  Classes="skua-button outline"
                  Height="32"
                  Content="Select All"
                  Command="{Binding SelectAllCommand}" />

          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="1"
                  Classes="skua-button outline"
                  Height="32"
                  Content="Clear Selection"
                  Command="{Binding ClearSelectionCommand}" />

          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="2"
                  Classes="skua-button"
                  Height="32"
                  Content="Mark Selected"
                  Command="{Binding MarkAsJunkCommand}" />

          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="3"
                  Classes="skua-button"
                  Height="32"
                  Content="Unmark Selected"
                  Command="{Binding UnmarkAsJunkCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*" ColumnSpacing="8">
          <Button Grid.Column="0"
                  Classes="skua-button outline"
                  Height="32"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Refresh inventory and bank">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
              <TextBlock Text="Refresh" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="1"
                  Classes="skua-button"
                  Height="32"
                  Content="Unmark All Junk"
                  Command="{Binding UnmarkAllJunkCommand}" />

          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="2"
                  Classes="skua-button skua-danger"
                  Height="32"
                  Command="{Binding SellSelectedCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <materialIcons:MaterialIcon Kind="CurrencyUsd" Width="14" Height="14" />
              <TextBlock Text="Sell Selected" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="3"
                  Classes="skua-button skua-danger"
                  Height="32"
                  Command="{Binding SellAllJunkCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <materialIcons:MaterialIcon Kind="DeleteSweep" Width="14" Height="14" />
              <TextBlock Text="Sell All Junk" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
