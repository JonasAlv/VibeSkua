<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vms="clr-namespace:Skua.App.Avalonia.ViewModels.CoreBotsOptions"
             xmlns:sharedOptions="clr-namespace:Skua.Shared.Avalonia.Controls.Options;assembly=Skua.Shared.Avalonia"
             x:Class="Skua.App.Avalonia.Views.CBOptionsView"
             x:DataType="vms:CBOptionsViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="8">
    <TextBox Grid.Row="0" Watermark="Filter CoreBots settings, delays, and parameters..." Text="{Binding SearchText, Mode=TwoWay}">
      <TextBox.InnerLeftContent>
        <materialIcons:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource SkuaMutedTextBrush}" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <Border Grid.Row="1" Classes="option-list" VerticalAlignment="Top">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
        <ItemsControl ItemsSource="{Binding FilteredOptions}" Margin="0,0,0,-1" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter:nth-child(2n+1) > Border.option-row"><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="option-row" MinHeight="38" Padding="12,3">
              <sharedOptions:OptionItemControl CompactText="True" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
