<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.ConsoleView">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="section-label" Text="C# SNIPPET" VerticalAlignment="Center" />
            <TextBlock FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" VerticalAlignment="Center">
                <Run Text="runs inside" />
                <Run Text="ScriptMain(IScriptInterface Bot)" FontFamily="Cascadia Mono,Consolas,Courier New,monospace" />
            </TextBlock>
        </StackPanel>

        <TextBox Grid.Row="1"
                 Text="{Binding SnippetText}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Padding="10,8"
                 FontFamily="JetBrains Mono,Consolas,Courier New,monospace" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="skua-button w84" Command="{Binding ClearCommand}" ToolTip.Tip="Clear the snippet">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="BackspaceOutline" Width="15" Height="15" />
                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="skua-button skua-primary w84" Command="{Binding RunCommand}" ToolTip.Tip="Compile and run the snippet">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Play" Width="15" Height="15" />
                    <TextBlock Text="Run" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
