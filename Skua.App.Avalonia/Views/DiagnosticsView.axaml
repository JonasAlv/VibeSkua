<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.Views.DiagnosticsView">
    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="12">
        
        <!-- Header Dashboard Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource SkuaSurfaceBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="PERFORMANCE &amp; HEALTH TELEMETRY"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    <TextBlock FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaTextBrush}"
                               Text="{Binding MonitoringStatus}" />
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Last Sample: {0}'}"
                               FontSize="11"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="skua-button"
                            Height="34"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="skua-button outline"
                            Height="34"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Export" Width="14" Height="14" />
                            <TextBlock Text="Export JSON" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Metric Stat Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <!-- Process Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="PROCESS &amp; CPU"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    <TextBlock Text="{Binding Process}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" />
                    <TextBlock Text="{Binding CpuTime}" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                    <TextBlock Text="{Binding Threads, StringFormat='Active Threads: {0}'}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Memory Card -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="MEMORY USAGE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    <TextBlock Text="{Binding WorkingSet, StringFormat='Working Set: {0}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" />
                    <TextBlock Text="{Binding ManagedHeap, StringFormat='Managed Heap: {0}'}" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                    <TextBlock Text="{Binding TotalAllocated, StringFormat='Total Allocated: {0}'}" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- Runtime Card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SkuaSurfaceBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock Text="RUNTIME &amp; GC"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                    <TextBlock Text="{Binding Collections}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SkuaTextBrush}" />
                    <TextBlock Text="{Binding ThreadPool}" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Events List Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource SkuaPageBrush}"
                BorderBrush="{DynamicResource SkuaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="RECENT TELEMETRY EVENTS"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                           Margin="6,4,0,8" />
                <ListBox Classes="card-list" ItemsSource="{Binding Events}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="list-card"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,4"
                                    Padding="10,6">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp}"
                                               FontFamily="JetBrains Mono,Consolas,Courier New,monospace"
                                               FontSize="11"
                                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SkuaSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="Medium" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{Binding Value}" FontFamily="JetBrains Mono,Consolas,Courier New,monospace" FontSize="11" Foreground="{DynamicResource SkuaTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
