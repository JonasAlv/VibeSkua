<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Skua.App.Avalonia.UserControls.LogTabUserControl">
  <Grid RowDefinitions="Auto,*">
    <!-- Action Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SkuaSurfaceAltBrush}"
            BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="0,0,0,1"
            Height="26"
            Padding="8,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Text="{Binding Title, StringFormat='LOGS: {0}'}"
                   FontSize="9"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                   VerticalAlignment="Center" />
        
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="skua-button"
                  Height="20"
                  Padding="6,0"
                  FontSize="10"
                  Command="{Binding ClearLogCommand}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="11" Height="11" />
              <TextBlock Text="Clear" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="skua-button"
                  Height="20"
                  Padding="6,0"
                  FontSize="10"
                  Click="CopyButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <materialIcons:MaterialIcon Kind="ContentCopy" Width="11" Height="11" />
              <TextBlock Text="Copy" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="skua-button"
                  Height="20"
                  Padding="6,0"
                  FontSize="10"
                  Command="{Binding SaveLogCommand}">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="11" Height="11" />
              <TextBlock Text="Save" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    
    <!-- Logs Stream ListBox -->
    <ListBox x:Name="LogsListBox"
             Grid.Row="1"
             ItemsSource="{Binding Logs}"
             SelectionMode="Multiple"
             KeyDown="LogsListBox_KeyDown"
             Background="Transparent"
             BorderThickness="0"
             Padding="4"
             ScrollViewer.VerticalScrollBarVisibility="Visible"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.AllowAutoHide="False"
             FontFamily="JetBrains Mono,Noto Sans Symbols,Noto Sans Symbols 2,Noto Color Emoji,Consolas,Courier New,monospace"
             FontSize="11"
             Foreground="{DynamicResource SkuaTextBrush}">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy Selected" Click="CopySelected_Click">
            <MenuItem.Icon>
              <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Copy All" Command="{Binding CopyLogCommand}">
            <MenuItem.Icon>
              <materialIcons:MaterialIcon Kind="SelectAll" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Clear Logs" Command="{Binding ClearLogCommand}">
            <MenuItem.Icon>
              <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,2" />
          <Setter Property="MinHeight" Value="18" />
          <Setter Property="CornerRadius" Value="3" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </Grid>
</UserControl>



