<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:shell="clr-namespace:Skua.Shared.Avalonia.Controls.Shell;assembly=Skua.Shared.Avalonia"
        xmlns:models="clr-namespace:Skua.Plugin.Cosmetics.Models"
        x:Class="Skua.Plugin.Cosmetics.Views.CosmeticsWindow"
        Classes="skua"
        Title="Cosmetics &amp; Outfits"
        Width="1020" Height="730"
        MinWidth="880" MinHeight="580"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Modern Main TabControl & TabItem Styling -->
        <Style Selector="TabControl.cosmetics-tabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl.cosmetics-tabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TabControl.cosmetics-tabs /template/ Rectangle#PART_Separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
        </Style>

        <!-- Selected State: Clean elevated card with crisp accent border, NO clunky block -->
        <Style Selector="TabControl.cosmetics-tabs TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SkuaTextBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
        </Style>

        <Style Selector="TabControl.cosmetics-tabs TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Tab Icons Reactive Styling -->
        <Style Selector="TabControl.cosmetics-tabs TabItem materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl.cosmetics-tabs TabItem:pointerover materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SkuaTextBrush}" />
        </Style>
        <Style Selector="TabControl.cosmetics-tabs TabItem:selected materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        </Style>

        <!-- Refined Category Filter Chips -->
        <Style Selector="Button.category-chip">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.category-chip /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceAltBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaMutedTextBrush}" />
        </Style>
        <Style Selector="Button.category-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaTextBrush}" />
        </Style>
        <Style Selector="Button.category-chip.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.category-chip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaNavHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SkuaAccentBrush}" />
        </Style>

        <!-- Primary & Danger Buttons -->
        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary-action /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SkuaAccentBrush}" />
            <Setter Property="TextBlock.Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.danger-action">
            <Setter Property="Background" Value="#E53935" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.preset-card">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource SkuaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkuaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource SkuaBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource SkuaSurfaceBrush}">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- 1. Window Title Bar -->
            <shell:WindowTitleBar Grid.Row="0" TitleText="Cosmetics &amp; Outfits" />

            <!-- 2. Global Quick Action Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                    <!-- Copy Target Look -->
                    <Button Grid.Column="0"
                            x:Name="BtnCopyTarget"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            ToolTip.Tip="Steal / copy the equipment and colors of your current targeted player"
                            Click="BtnCopyTarget_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="AccountEye" Width="16" Height="16" Foreground="{DynamicResource SkuaAccentBrush}" />
                            <TextBlock Text="Copy Target Look" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Room Players Picker -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                        <ComboBox x:Name="RoomPlayersCombo"
                                  Width="130"
                                  Height="30"
                                  FontSize="11"
                                  PlaceholderText="Room players..."
                                  DropDownOpened="RoomPlayersCombo_DropDownOpened" />
                        <Button Height="30"
                                Width="30"
                                Padding="0"
                                ToolTip.Tip="Copy look from selected room player"
                                Click="BtnCopyRoomPlayer_Click">
                            <materialIcons:MaterialIcon Kind="AccountArrowRight" Width="15" Height="15" />
                        </Button>
                    </StackPanel>

                    <!-- Reset to Real Gear -->
                    <Button Grid.Column="2"
                            Height="30"
                            Padding="10,0"
                            ToolTip.Tip="Revert avatar back to your actual equipped inventory items"
                            Click="BtnResetRealGear_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Restore" Width="16" Height="16" Foreground="#FFB74D" />
                            <TextBlock Text="Reset to Real Gear" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Status Notification Text -->
                    <TextBlock Grid.Column="3"
                               x:Name="QuickActionBarStatus"
                               Text=""
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource SkuaAccentBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Gender Morpher Quick Buttons -->
                    <Border Grid.Column="4"
                            Background="{DynamicResource SkuaSurfaceBrush}"
                            BorderBrush="{DynamicResource SkuaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Height="26" Width="26" Padding="0" ToolTip.Tip="Morph Male" Click="GenderMale_Click">
                                <materialIcons:MaterialIcon Kind="GenderMale" Width="14" Height="14" Foreground="#64B5F6" />
                            </Button>
                            <Button Height="26" Width="26" Padding="0" ToolTip.Tip="Morph Female" Click="GenderFemale_Click">
                                <materialIcons:MaterialIcon Kind="GenderFemale" Width="14" Height="14" Foreground="#F06292" />
                            </Button>
                            <Button Height="26" Width="26" Padding="0" ToolTip.Tip="Swap Gender" Click="GenderSwap_Click">
                                <materialIcons:MaterialIcon Kind="GenderTransgender" Width="14" Height="14" Foreground="{DynamicResource SkuaAccentBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Main Tabs -->
            <TabControl Grid.Row="2" Classes="cosmetics-tabs" Margin="14,10,14,12">

                <!-- ==================== TAB 1: CATALOG ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="TshirtCrew" Width="16" Height="16" />
                            <TextBlock Text="Catalog" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                        <!-- Top Search, Sort, and Sync Row -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0"
                                     x:Name="SearchBox"
                                     Watermark="Search cosmetics by name or ID..."
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyUp="SearchBox_KeyUp" />

                            <Button Grid.Column="1"
                                    Height="32"
                                    Width="32"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    ToolTip.Tip="Clear Search"
                                    Click="ClearSearch_Click">
                                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                            </Button>

                            <!-- Sorting Dropdown -->
                            <ComboBox Grid.Column="2"
                                      x:Name="SortCombo"
                                      Height="32"
                                      Width="160"
                                      Margin="6,0,0,0"
                                      FontSize="11"
                                      SelectionChanged="SortCombo_SelectionChanged">
                                <ComboBoxItem Content="Newest First (ID ↓)" IsSelected="True" Tag="Newest" />
                                <ComboBoxItem Content="Oldest First (ID ↑)" Tag="Oldest" />
                                <ComboBoxItem Content="Name (A → Z)" Tag="NameAsc" />
                                <ComboBoxItem Content="Name (Z → A)" Tag="NameDesc" />
                            </ComboBox>

                            <Button Grid.Column="3"
                                    x:Name="BtnSyncUpdates"
                                    Height="32"
                                    Padding="10,0"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="Check for new cosmetics in background"
                                    Click="CheckCatalogUpdates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="CloudSync" Width="16" Height="16" />
                                    <TextBlock Text="Check Updates" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="4"
                                       x:Name="CatalogStatusText"
                                       Text="Loading local catalog..."
                                       Foreground="{DynamicResource SkuaMutedTextBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Margin="12,0,4,0" />
                        </Grid>

                        <!-- Filter Chips Row -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <ComboBox x:Name="WeaponSubcategoryCombo"
                                      DockPanel.Dock="Right"
                                      Width="130"
                                      Height="28"
                                      FontSize="11"
                                      SelectionChanged="WeaponSubcategoryCombo_SelectionChanged"
                                      IsVisible="False"
                                      Margin="6,0,0,0">
                                <ComboBoxItem Content="All Weapons" IsSelected="True" />
                                <ComboBoxItem Content="Sword" />
                                <ComboBoxItem Content="Axe" />
                                <ComboBoxItem Content="Dagger" />
                                <ComboBoxItem Content="Gun" />
                                <ComboBoxItem Content="HandGun" />
                                <ComboBoxItem Content="Rifle" />
                                <ComboBoxItem Content="Bow" />
                                <ComboBoxItem Content="Mace" />
                                <ComboBoxItem Content="Gauntlet" />
                                <ComboBoxItem Content="Polearm" />
                                <ComboBoxItem Content="Staff" />
                                <ComboBoxItem Content="Wand" />
                                <ComboBoxItem Content="Whip" />
                            </ComboBox>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="ChipAll" Classes="category-chip active" Content="All" Click="CategoryChip_Click" Tag="All" />
                                    <Button x:Name="ChipArmor" Classes="category-chip" Content="Armor" Click="CategoryChip_Click" Tag="Armor" />
                                    <Button x:Name="ChipWeapon" Classes="category-chip" Content="Weapon" Click="CategoryChip_Click" Tag="Weapon" />
                                    <Button x:Name="ChipHelm" Classes="category-chip" Content="Helm" Click="CategoryChip_Click" Tag="Helm" />
                                    <Button x:Name="ChipCape" Classes="category-chip" Content="Cape" Click="CategoryChip_Click" Tag="Cape" />
                                    <Button x:Name="ChipPet" Classes="category-chip" Content="Pet" Click="CategoryChip_Click" Tag="Pet" />
                                    <Button x:Name="ChipRune" Classes="category-chip" Content="Ground Rune" Click="CategoryChip_Click" Tag="Rune" />
                                    <Button x:Name="ChipFav" Classes="category-chip" Click="CategoryChip_Click" Tag="Favorites">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="Heart" Width="12" Height="12" Foreground="Red" />
                                            <TextBlock Text="Favorites" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Main Split Content: Items List + Detail Pane -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,310">
                            <!-- Left: ListBox & Pagination -->
                            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SkuaSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource SkuaBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ListBox x:Name="ItemsListBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionChanged="ItemsListBox_SelectionChanged"
                                             DoubleTapped="ItemsListBox_DoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:CosmeticItem">
                                                <Grid Margin="2,4" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource SkuaTextBrush}" />
                                                            <Border Background="{DynamicResource SkuaNavHoverBrush}"
                                                                    CornerRadius="4"
                                                                    Padding="5,1">
                                                                <TextBlock Text="{Binding DisplayCategory}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SkuaAccentBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ID, StringFormat='ID: {0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <materialIcons:MaterialIcon Kind="Heart"
                                                                                  Width="14" Height="14"
                                                                                  Foreground="Red"
                                                                                  IsVisible="{Binding IsFavorite}"
                                                                                  VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Pagination Bar -->
                                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Left">
                                        <Button Width="28" Height="28" Padding="0" ToolTip.Tip="First Page" Click="PageFirst_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronDoubleLeft" Width="16" Height="16" />
                                        </Button>
                                        <Button Width="28" Height="28" Padding="0" ToolTip.Tip="Previous Page" Click="PagePrev_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                                        </Button>
                                        <TextBlock x:Name="PaginationInfoText"
                                                   Text="Page 1 of 1"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Margin="8,0"
                                                   Foreground="{DynamicResource SkuaTextBrush}" />
                                        <Button Width="28" Height="28" Padding="0" ToolTip.Tip="Next Page" Click="PageNext_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
                                        </Button>
                                        <Button Width="28" Height="28" Padding="0" ToolTip.Tip="Last Page" Click="PageLast_Click">
                                            <materialIcons:MaterialIcon Kind="ChevronDoubleRight" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <TextBlock Text="Per Page:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        <ComboBox x:Name="PageSizeCombo"
                                                  Width="75"
                                                  Height="28"
                                                  FontSize="11"
                                                  SelectionChanged="PageSizeCombo_SelectionChanged">
                                            <ComboBoxItem Content="50" IsSelected="True" />
                                            <ComboBoxItem Content="100" />
                                            <ComboBoxItem Content="250" />
                                            <ComboBoxItem Content="500" />
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- Right: Selected Item Details & Actions -->
                            <Border Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <!-- Header / Title -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="SELECTED COSMETIC"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            <TextBlock x:Name="DetailItemName"
                                                       Text="No Item Selected"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SkuaAccentBrush}"
                                                       TextWrapping="Wrap" />
                                            <Border x:Name="DetailCategoryBadge"
                                                     Background="{DynamicResource SkuaNavHoverBrush}"
                                                     CornerRadius="4"
                                                     Padding="6,2"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="False">
                                                <TextBlock x:Name="DetailCategoryText"
                                                           Text="Category"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SkuaTextBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,2" />

                                        <!-- Meta Info -->
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="DetailItemID" Text="ID: -" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            <TextBlock x:Name="DetailItemPath" Text="File: -" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DetailItemLink" Text="Link: -" FontSize="11" Foreground="{DynamicResource SkuaMutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,2" />

                                        <!-- Action Buttons -->
                                        <StackPanel Spacing="8">
                                            <Button x:Name="BtnEquip"
                                                    Classes="primary-action"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnEquip_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="TshirtCrew" Width="16" Height="16" />
                                                    <TextBlock Text="Equip Look" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="BtnFavorite"
                                                    Height="32"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnFavorite_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <materialIcons:MaterialIcon x:Name="FavIcon" Kind="HeartOutline" Width="16" Height="16" />
                                                    <TextBlock x:Name="FavBtnText" Text="Add to Favorites" VerticalAlignment="Center" FontSize="11" />
                                                </StackPanel>
                                            </Button>

                                            <Button Height="30"
                                                    HorizontalAlignment="Stretch"
                                                    Click="BtnWiki_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="14" Height="14" />
                                                    <TextBlock Text="Open on AQW Wiki" VerticalAlignment="Center" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 2: SAVED OUTFITS & INSPECTOR ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Wardrobe" Width="16" Height="16" />
                            <TextBlock Text="Outfits &amp; Inspector" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid ColumnDefinitions="*,380" Margin="0,8,0,0">
                        <!-- Left Column: Saved Sets List -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Height="32" Padding="12,0" Classes="primary-action" DockPanel.Dock="Left" Click="CaptureLook_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Camera" Width="16" Height="16" />
                                        <TextBlock Text="Save Current Look" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="SetsCountText"
                                           Text="0 Outfits Saved"
                                           Foreground="{DynamicResource SkuaMutedTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           DockPanel.Dock="Right"
                                           FontSize="11" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource SkuaSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource SkuaBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ListBox Classes="card-list" x:Name="SetsListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="SetsListBox_SelectionChanged"
                                         DoubleTapped="SetsListBox_DoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CosmeticSet">
                                            <Border Classes="list-card"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SkuaAccentBrush}" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SkuaTextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Saved: {0:yyyy-MM-dd HH:mm}'}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Height="30"
                                                            Padding="12,0"
                                                            VerticalAlignment="Center"
                                                            Classes="primary-action"
                                                            Tag="{Binding}"
                                                            Click="ApplySetItem_Click">
                                                        <TextBlock Text="Equip" FontSize="11" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- Right Column: Outfit Inspector & Partial Equip -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="OUTFIT INSPECTOR"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        <TextBlock x:Name="InspectorSetName"
                                                   Text="Select an Outfit"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SkuaAccentBrush}" />
                                        <TextBlock x:Name="InspectorSetDate"
                                                   Text="-"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,2" />

                                    <!-- Slot Rows -->
                                    <StackPanel Spacing="8">
                                        <!-- Armor Slot -->
                                        <Border Background="{DynamicResource SkuaSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ShieldAccount" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Armor / Class" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectArmorName" Text="None" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipArmor" Height="26" Padding="8,0" FontSize="10" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Armor" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Helm Slot -->
                                        <Border Background="{DynamicResource SkuaSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="HardHat" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Helm" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectHelmName" Text="None" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipHelm" Height="26" Padding="8,0" FontSize="10" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Helm" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Cape Slot -->
                                        <Border Background="{DynamicResource SkuaSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="FlagVariant" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Cape" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectCapeName" Text="None" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipCape" Height="26" Padding="8,0" FontSize="10" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Cape" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Weapon Slot -->
                                        <Border Background="{DynamicResource SkuaSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Sword" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Weapon" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectWeaponName" Text="None" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipWeapon" Height="26" Padding="8,0" FontSize="10" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Weapon" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Pet Slot -->
                                        <Border Background="{DynamicResource SkuaSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Paw" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Pet" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectPetName" Text="None" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipPet" Height="26" Padding="8,0" FontSize="10" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Pet" IsEnabled="False" />
                                            </Grid>
                                        </Border>

                                        <!-- Rune Slot -->
                                        <Border Background="{DynamicResource SkuaSurfaceBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CircleDouble" Width="18" Height="18" Foreground="{DynamicResource SkuaAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Ground Rune" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                                    <TextBlock x:Name="InspectRuneName" Text="None" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" x:Name="BtnInspectEquipRune" Height="26" Padding="8,0" FontSize="10" Content="Equip" Click="BtnInspectEquipSlot_Click" Tag="Rune" IsEnabled="False" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" Margin="0,4" />

                                    <!-- Bottom Set Actions -->
                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <Button x:Name="BtnInspectEquipAll"
                                                Classes="primary-action"
                                                Margin="0,0,4,0"
                                                IsEnabled="False"
                                                Click="EquipSelectedSet_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CheckAll" Width="16" Height="16" />
                                                <TextBlock Text="Equip Full Set" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BtnInspectDelete"
                                                Classes="danger-action"
                                                Margin="4,0,0,0"
                                                IsEnabled="False"
                                                Click="DeleteSelectedSet_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16" />
                                                <TextBlock Text="Delete Set" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 3: COLOR CUSTOM (CC) ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Palette" Width="16" Height="16" />
                            <TextBlock Text="Color Custom (CC)" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid ColumnDefinitions="*,340" Margin="0,8,0,0">
                        <!-- Left: Color Swatches & Hex Editors -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Character Color Customizer"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SkuaAccentBrush}" />
                                        <TextBlock Text="Directly modify your client-side Base, Trim, Accessory, and Eye colors."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                    </StackPanel>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" />

                                    <!-- 6 Color Rows -->
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*,50" RowSpacing="10">
                                        <!-- Base Color -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Base Color" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Primary Armor / Clothes" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CcBaseHex" Watermark="#RRGGBB" Height="32" VerticalContentAlignment="Center" Margin="10,0" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="0" Grid.Column="2" x:Name="CcBaseSwatch" CornerRadius="4" Height="32" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" />

                                        <!-- Trim Color -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Trim Color" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Secondary Highlights" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CcTrimHex" Watermark="#RRGGBB" Height="32" VerticalContentAlignment="Center" Margin="10,0" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="1" Grid.Column="2" x:Name="CcTrimSwatch" CornerRadius="4" Height="32" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" />

                                        <!-- Accessory Color -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Accessory Color" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Gems, Accents, Glows" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CcAccHex" Watermark="#RRGGBB" Height="32" VerticalContentAlignment="Center" Margin="10,0" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="2" Grid.Column="2" x:Name="CcAccSwatch" CornerRadius="4" Height="32" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" />

                                        <!-- Eye Color -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Eye Color" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Pupils &amp; Eyes" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CcEyeHex" Watermark="#RRGGBB" Height="32" VerticalContentAlignment="Center" Margin="10,0" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="3" Grid.Column="2" x:Name="CcEyeSwatch" CornerRadius="4" Height="32" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" />

                                        <!-- Skin Color -->
                                        <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Skin Color" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Body &amp; Face Tone" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="CcSkinHex" Watermark="#RRGGBB" Height="32" VerticalContentAlignment="Center" Margin="10,0" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="4" Grid.Column="2" x:Name="CcSkinSwatch" CornerRadius="4" Height="32" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" />

                                        <!-- Hair Color -->
                                        <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Hair Color" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Text="Hair &amp; Eyebrows" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                        </StackPanel>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="CcHairHex" Watermark="#RRGGBB" Height="32" VerticalContentAlignment="Center" Margin="10,0" TextChanged="CcHex_TextChanged" />
                                        <Border Grid.Row="5" Grid.Column="2" x:Name="CcHairSwatch" CornerRadius="4" Height="32" BorderBrush="{DynamicResource SkuaBorderBrush}" BorderThickness="1" />
                                    </Grid>

                                    <Separator Background="{DynamicResource SkuaBorderBrush}" />

                                    <!-- Action Buttons -->
                                    <UniformGrid Columns="2">
                                        <Button Classes="primary-action" Margin="0,0,6,0" Click="ApplyColors_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FormatColorFill" Width="16" Height="16" />
                                                <TextBlock Text="Apply Palette" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Height="34" Margin="6,0,0,0" Click="ReadCurrentColors_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Eyedropper" Width="16" Height="16" />
                                                <TextBlock Text="Read Avatar Colors" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>

                                    <TextBlock x:Name="CcStatusText" Text="" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SkuaAccentBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Preset Palettes -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SkuaSurfaceAltBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="THEMED PRESETS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SkuaMutedTextBrush}" />

                                    <!-- Preset 1: Void Fiend -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#1A0826|#8A2BE2|#E0B0FF|#FF00FF">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Void Fiend" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Deep obsidian purple" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#1A0826" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#8A2BE2" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#E0B0FF" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 2: Legion Soul -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#0D1117|#00E5FF|#1DE9B6|#00FFFF">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Legion Soul" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Underworld cyan glow" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#0D1117" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#00E5FF" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#1DE9B6" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 3: Shadow Assassin -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#0D0D0D|#262626|#404040|#FF1744">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Shadow Assassin" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Pure stealth black &amp; crimson" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#0D0D0D" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#262626" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#FF1744" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 4: Celestial Light -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#F5F5F5|#FFD700|#FFB300|#40C4FF">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Celestial Light" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Pure white &amp; heavenly gold" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#F5F5F5" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#FFD700" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#FFB300" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 5: Doom Crimson -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#1F0000|#800000|#FF1A1A|#FF3333">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Doom Crimson" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Blood vampire scarlet" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#1F0000" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#800000" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#FF1A1A" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 6: Cyber Synth -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#180033|#FF007F|#00F0FF|#FFFF00">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Cyber Synth" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Neon magenta &amp; cyan" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#180033" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#FF007F" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#00F0FF" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 7: Royal Gold -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#1C1C1C|#D4AF37|#F3E5AB|#FFD700">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Royal Gold" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Gilded imperial regalia" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#1C1C1C" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#D4AF37" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#F3E5AB" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Preset 8: Pure Frost -->
                                    <Button Classes="preset-card" Click="Preset_Click" Tag="#E0F7FA|#80DEEA|#00BCD4|#00E5FF">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Pure Frost" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SkuaTextBrush}" />
                                                <TextBlock Text="Glacial crystalline ice" FontSize="10" Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#E0F7FA" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#80DEEA" />
                                                <Border Width="14" Height="24" CornerRadius="2" Background="#00BCD4" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== TAB 4: MANUAL INJECTOR ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="16" Height="16" />
                            <TextBlock Text="Manual SWF" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <Border Background="{DynamicResource SkuaSurfaceAltBrush}"
                                BorderBrush="{DynamicResource SkuaBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                MaxWidth="620"
                                HorizontalAlignment="Center">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Direct SWF Injection"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SkuaAccentBrush}" />
                                    <TextBlock Text="Visually loads any raw SWF file onto your avatar by path and linkage ID."
                                               FontSize="12"
                                               Foreground="{DynamicResource SkuaMutedTextBrush}" />
                                </StackPanel>

                                <Separator Background="{DynamicResource SkuaBorderBrush}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="SWF File Path (sFile)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBox x:Name="ManualFileText"
                                             Watermark="e.g. classes/M/Warrior.swf or items/helms/MyHelm.swf"
                                             Height="32"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Linkage Identifier (sLink)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBox x:Name="ManualLinkText"
                                             Watermark="e.g. mWarrior or HelmLink"
                                             Height="32"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Equipment Slot / Group" FontWeight="SemiBold" FontSize="12" />
                                    <ComboBox x:Name="ManualSlotCombo"
                                              HorizontalAlignment="Stretch"
                                              Height="32">
                                        <ComboBoxItem Content="Armor / Class (co)" IsSelected="True" Tag="co" />
                                        <ComboBoxItem Content="Helm (he)" Tag="he" />
                                        <ComboBoxItem Content="Cape (ba)" Tag="ba" />
                                        <ComboBoxItem Content="Weapon (Weapon)" Tag="Weapon" />
                                        <ComboBoxItem Content="Pet (pe)" Tag="pe" />
                                        <ComboBoxItem Content="Ground Rune / Misc (mi)" Tag="mi" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Meta Data (sMeta, Optional)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBox x:Name="ManualMetaText"
                                             Watermark="Optional metadata or buff identifiers"
                                             Height="32"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>

                                <Button Height="38"
                                        Classes="primary-action"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Click="ManualInject_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Flash" Width="18" Height="18" />
                                        <TextBlock Text="Inject SWF Onto Character" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="ManualStatusText"
                                           Text=""
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SkuaAccentBrush}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
